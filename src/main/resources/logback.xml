<configuration>
   <!-- formato da saída do log no Console -->
   <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
      <!--
      A configuração à seguir é obrigatória, pois qualquer saída de dados no
      console (System.out.print(ln)) vai "quebrar" o protocolo JSON-RPC, usado
      na comunicação entre cliente, seja próprio ou Claude Desktop, p.ex., e
      servidor.
      -->
      <target>System.err</target>
      <encoder>
         <charset>UTF-8</charset>
         <pattern>
            %d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n
         </pattern>
      </encoder>
   </appender>

   <!-- nível de log padrão da aplicação -->
   <root level="INFO">
      <appender-ref ref="CONSOLE" />
   </root>

   <!--
   ajusta o log dos pacotes da aplicação para exibições detalhadas (DEBUG)
   -->
   <logger name="br.edu.ifpr.mcp_academico" level="DEBUG" />

   <!-- detalhes internos do SDK não interessam ao usuário do cliente -->
   <logger name="io.modelcontextprotocol" level="WARN" />

   <!--
   ao fechar a conexão, o cliente do SDK finaliza o processo do servidor com
   Process.destroy(), que no Windows sempre resulta no código de saída 1, e
   registra o aviso "MCP server process failed with code 1", que não indica
   uma falha do servidor
   -->
   <logger name="io.modelcontextprotocol.client.transport.StdioClientTransport"
           level="ERROR" />
</configuration>
